<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>io.github.hpixsel.connectsound</ApplicationId>
    <ApplicationTitle>ConnectSound</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <!-- 1.2.3 -> 10203: grows with every release, which Android requires for updates. -->
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse($(Version)).Minor), 100)))), $([System.Version]::Parse($(Version)).Build)))</ApplicationVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <RunAOTCompilation>false</RunAOTCompilation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <!-- SkiaSharp 3 ships 16 KB-aligned native libraries, required on Android 15+ devices with 16 KB pages. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.119.4" />
    <PackageReference Include="HarfBuzzSharp" Version="8.3.1.5" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" Version="8.3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ConnectSound.UI\ConnectSound.UI.csproj" />
  </ItemGroup>
</Project>
